---
const { id, title, description, bullets, ctaLabel, href, image, imageAlt } = Astro.props;
const titleId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<article id={id} class="service-card" role="group" aria-labelledby={titleId} data-reveal>
  <div class="service-image">
    <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
  </div>
  <div class="service-copy">
    <h3 id={titleId}>{title}</h3>
    <div class="service-content">
      <p>{description}</p>
      <ul>
        {bullets.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <a class="service-cta" href={href}>{ctaLabel}</a>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    background: #ffffff;
    box-shadow: 0 24px 60px rgba(16, 16, 16, 0.06);
    border: 1px solid rgba(17, 17, 17, 0.08);
    transition: transform 220ms ease, box-shadow 220ms ease;
    height: 100%;
    box-sizing: border-box;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 32px 90px rgba(16, 16, 16, 0.08);
  }

  .service-image img {
    width: 100%;
    height: 220px;
    display: block;
    object-fit: cover;
  }
  .service-copy {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  .service-copy h3 {
    margin: 0;
    margin-top: 0.4rem;
    font-size: clamp(1.55rem, 2vw, 2rem);
    line-height: 1.05;
    color: #111111;
    text-align: left;
  }

  .service-content {
    margin-top: 0.75rem;
    color: #444444;
    line-height: 1.75;
    font-size: 1rem;
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1 1 auto;
  }

  .service-content p { margin: 0; }

  .service-copy ul {
    margin: 0;
    padding-left: 1.35rem;
    color: #333333;
    line-height: 1.8;
  }

  .service-copy li { margin-bottom: 0.85rem; }

  .service-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.6rem;
    border-radius: 999px;
    border: 1px solid #b18f6a;
    background: #ffffff;
    color: #111111;
    font-weight: 600;
    text-decoration: none;
    transition: background 200ms ease, transform 200ms ease;
    margin-top: 1rem;
    align-self: flex-start;
    text-align: center;
    white-space: normal;
  }

  .service-cta:hover {
    background: #f7efe6;
    transform: translateY(-1px);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    animation: revealUp 0.9s ease forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
