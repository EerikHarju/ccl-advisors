---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	lang?: string;
}

const baseUrl = Astro.site || 'https://ccladvisors.com';
const currentPath = Astro.url.pathname;
const altPaths = {
  en: currentPath.startsWith('/fi') ? currentPath.replace(/^\/fi/, '/en') : currentPath.startsWith('/en') ? currentPath : `/en${currentPath === '/' ? '/' : currentPath}`,
  fi: currentPath.startsWith('/en') ? currentPath.replace(/^\/en/, '/fi') : currentPath.startsWith('/fi') ? currentPath : `/fi${currentPath === '/' ? '/' : currentPath}`
};
const canonicalURL = new URL(currentPath, baseUrl).href;
const altEn = new URL(altPaths.en, baseUrl).href;
const altFi = new URL(altPaths.fi, baseUrl).href;
const { title, description, image = '/media/IMG_5760.JPG', lang = 'en' } = Astro.props;
const ogLocale = lang === 'fi' ? 'fi_FI' : 'en_US';
const absoluteImage = new URL(image, baseUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      'name': 'CCL Advisory Oy',
      'url': 'https://ccladvisors.com',
      'logo': 'https://ccladvisors.com/media/IMG_5760.JPG',
      'sameAs': [
        'https://www.linkedin.com/in/mikko-harju-38a39b4/'
      ]
    },
    {
      '@type': 'LegalService',
      'name': 'CCL Advisory',
      'description': description,
      'serviceType': 'Legal advisory',
      'areaServed': {
        '@type': 'Country',
        'name': 'Finland'
      },
      'provider': {
        '@type': 'Organization',
        'name': 'CCL Advisory Oy'
      }
    },
    {
      '@type': 'Person',
      'name': 'Mikko Harju',
      'jobTitle': 'Founder & Senior Legal Advisor',
      'worksFor': {
        '@type': 'Organization',
        'name': 'CCL Advisory Oy'
      }
    }
  ]
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hrefLang="en" href={altEn} />
<link rel="alternate" hrefLang="fi" href={altFi} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={absoluteImage} />
<meta property="twitter:image:alt" content={title} />

<script type="application/ld+json">
  {JSON.stringify(jsonLd)}
</script>
