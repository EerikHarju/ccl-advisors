---
import Layout from '../../layouts/Layout.astro';
import rawHeroImage from '../../../public/media/IMG_5760.JPG';
import rawWhyImage from '../../../public/media/001381380001.jpg';

import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

const optimizedHero = await getImage({ src: rawHeroImage });
const optimizedWhy = await getImage({ src: rawWhyImage });

const title = 'CCL Advisory | About';
const description =
  'Professional legal advisory services for complex transactions, commercial contracts, corporate matters and legal operations.';


---

<Layout title={title} description={description} lang="en">
  <section class="hero-section" style={`background-image: url(${optimizedHero.src});`}>
    <div class="hero-content">
      <h1>CCL Advisory</h1>
      <p>Bespoke legal and consulting advisory services.</p>
      <a href="/en/contact" class="hero-cta">Get In Touch</a>
    </div>
  </section>

  <section class="why-section">
    <div class="why-content">
      <h2>About CCL Advisory</h2>
      <div class="why-grid">
        <div class="why-card">
          <p>
            Welcome to CCL Advisory, a boutique law and business consulting firm delivering bespoke, 
            premium solutions in complex transactions, corporate governance, and legal operations. 
            Our commitment to excellence and deep cross-border expertise ensures clients receive commercially 
            astute, high-caliber advisory services.​
</p>
<p>
CCL Advisory was founded by Mikko Harju on the principle that focused, 
hands-on legal support — leveraging decades of international deal-making — serves clients best. 
With over 20 years living and working across Asia (China, India, Hong Kong), Mikko brings 
unparalleled international experience from publically listed companies and top-tier law firms.

          </p>
          
        </div>
        <div class="why-card">
          <p>

Mikko's track record spans advising Nordic and international clients on M&A, joint ventures, 
corporate structuring, and commercial contracts in competitive markets. 

Holding an LL.M. from the University of Helsinki and a post-graduate Master’s in EU Competition Law 
from Amsterdam, Mikko combines technical legal depth with business acumen from legal and business leadership roles. 
Prior to establishing CCL Advisory, Mikko advised both domestic and international clients at KPMG Legal.

To discuss your transaction or corporate needs, please get in touch. Learn more about Mikko’s background on LinkedIn.​
          </p>
        </div>
      </div>
    </div>
  </section>

  </Layout>

<style>
  .hero-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    height: 100vh;
    min-height: 600px;
    background-position: center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-content {
    text-align: center;
    color: white;
    max-width: 750px;
    padding: 1.5rem;
    border-radius: 12px;
  }

  .hero-section h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 600;
    line-height: 1.15;
    margin: 1rem 0 7.55rem 0;
    color: white !important;
  }

  .hero-section p {
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 300;
    line-height: 1.5;
    color: white;
    max-width: 750px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta,
  .about-cta {
    width: 240px;
    height: 62px;
    line-height: 58px;
    padding: 0;
    display: block;
    text-align: center;
    border-radius: 40px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 300ms ease;
    text-decoration: none;
  }

  .hero-cta {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.6);
    color: white;
    margin: 1rem auto 2rem auto;
  }

  .hero-cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.9);
    transform: translateY(-2px);
  }

  .why-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    padding: 4rem 0;
    background-position: center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .why-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .why-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.52);
    z-index: 0;
  }

  .why-section h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 3rem 0;
    text-align: left;
    color: rgb(var(--black));
    position: relative;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    position: relative;
  }

  .why-card {
    padding: 2rem;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .why-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
    color: rgb(var(--black));
  }

  .why-card p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0;
    color: rgb(var(--gray-dark));
    text-align: left;
  }

  @media (max-width: 768px) {
    .hero-section {
      background-attachment: scroll;
      height: 100vh;
      background-position: center 40%;
    }

    .hero-content {
      padding: 1.25rem;
    }

    .why-section {
      padding: 3rem 1rem;
      background-attachment: scroll;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
