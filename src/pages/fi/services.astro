---
import Layout from "../../layouts/Layout.astro";

import rawHeroImage from '../../../public/media/IMG_5760.JPG';
import { getImage } from 'astro:assets';

const optimizedHero = await getImage({ src: rawHeroImage });

const title = 'CCL Advisory | Services';
const description =
  'Professional legal advisory services across transactions, commercial contracts, corporate matters and legal operations.';

const intro =
  "We provide four core service areas designed to support your business across transactions, commercial contracts, corporate matters, and legal operations.";
---

<Layout title={title} description={description} lang="en">

  <!-- HERO SECTION -->
  <section 
    class="hero-section" 
    style={`background-image: url(${optimizedHero.src});`}
  >
    <div class="hero-content">
      <h1>Our Services</h1>
      <p>{intro}</p>
    </div>
  </section>

  <!-- SERVICE SECTIONS -->
  <section id="transactions" class="service-section">
    <div class="service-inner">
      <h2 class="service-title">Transactions</h2>
      <p class="service-description">
        We support clients through mergers, acquisitions, divestments, financing rounds, and strategic transactions with clear, business‑driven legal guidance.
      </p>

      <div class="service-icon-wrapper">
        <img src="/media/handshake.png" alt="Transactions icon" class="service-icon" />
        <span class="credit-number">¹</span>
      </div>
    </div>
  </section>

  <section id="commercial-contracts" class="service-section">
    <div class="service-inner">
      <h2 class="service-title">Commercial Contracts</h2>
      <p class="service-description">
        We draft, negotiate, and optimize commercial agreements that protect your interests and enable smooth business operations.
      </p>

      <div class="service-icon-wrapper">
        <img src="/media/contract.png" alt="Commercial contracts icon" class="service-icon" />
        <span class="credit-number">²</span>
      </div>
    </div>
  </section>

  <section id="corporate" class="service-section">
    <div class="service-inner">
      <h2 class="service-title">Corporate</h2>
      <p class="service-description">
        We advise on corporate governance, board matters, shareholder issues, and compliance to ensure your company operates with clarity and confidence.
      </p>

      <div class="service-icon-wrapper">
        <img src="/media/office-building.png" alt="Corporate icon" class="service-icon" />
        <span class="credit-number">³</span>
      </div>
    </div>
  </section>

  <section id="legal-operations" class="service-section">
    <div class="service-inner">
      <h2 class="service-title">Legal Operations</h2>
      <p class="service-description">
        We help organizations modernize their legal function through process design, tooling, automation, and operational excellence.
      </p>

      <div class="service-icon-wrapper">
        <img src="/media/kanban.png" alt="Legal operations icon" class="service-icon" />
        <span class="credit-number">⁴</span>
      </div>
    </div>
  </section>

  <!-- CREDITS -->
  <section class="credits">
    <p>
      <strong>Credits:</strong>
      <a href="https://www.flaticon.com/free-icons/partnership-handshake">¹</a>
      <a href="https://www.flaticon.com/free-icons/contract">²</a>
      <a href="https://www.flaticon.com/free-icons/company">³</a>
      <a href="https://www.flaticon.com/free-icons/kanban">⁴</a>
    </p>
  </section>

</Layout>

<style>
  /* HERO SECTION */
  .hero-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    height: 100vh;
    min-height: 600px;
    background-position: center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-section h1 {
    color: white !important;
  }

  .hero-content {
    text-align: center;
    color: white;
    max-width: 750px;
    padding: 1.5rem;
    border-radius: 12px;
  }

  /* SERVICE SECTIONS */
  .service-section {
    padding: 100px 0;
    background-color: white;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .service-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .service-title {
    font-size: 2rem;
    margin-bottom: 20px;
    font-weight: 600;
    position: relative;
    padding-bottom: 10px;
  }

  .service-description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #444;
    max-width: 700px;
    margin-bottom: 25px;
  }

  /* ICONS */
  .service-icon-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 30px;
  }

  .service-icon {
    width: 240px;   /* 4× larger */
    height: auto;
    opacity: 0.95;
  }

  .credit-number {
    font-size: 1.2rem;
    opacity: 0.6;
    position: relative;
    top: -12px;
  }

  /* CREDITS */
  .credits {
    text-align: center;
    padding: 40px 0;
    font-size: 0.9rem;
    color: #666;
  }

  .credits a {
    margin: 0 6px;
    text-decoration: none;
    color: #666;
  }

  .credits a:hover {
    text-decoration: underline;
  }
</style>
