---
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import rawHeroImage from '../../../public/media/IMG_5760.JPG';
import { getImage } from 'astro:assets';

const hero = await getImage({
  src: rawHeroImage,
  widths: [600, 900, 1400],
  formats: ['webp', 'jpg'],
  quality: 80,
});

const title = 'CCL Advisory | Palvelut';
const description = 'Kaupallisia juridisia palveluja yrityskauppoihin, sopimuksiin, yhtiöoikeuteen ja oikeudellisiin toimintoihin.';

const services = [
  {
    id: 'transactions',
    title: 'Kaupankäynti',
    description: 'Tuemme omistajia, sijoittajia ja johtoa merkittävissä transaktioissa hallitusti ja liiketaloudellisesti vahvoina.',
    bullets: [
      'Yrityskaupat, liiketoimintasiirrot ja osakejärjestelyt',
      'Due diligence ja rakenneoptimointi'
    ],
    ctaLabel: 'Keskustele kaupasta',
    href: '#contact',
    image: '/media/IMG_5760.JPG',
    imageAlt: 'Neuvottelutilanne juridisten asiakirjojen äärellä'
  },
  {
    id: 'commercial-contracts',
    title: 'Kaupalliset sopimukset',
    description: 'Teemme sopimuksista selkeämpiä, suojatumpia ja käyttökelpoisempia liiketoimintasi kasvun tukemiseksi.',
    bullets: [
      'Toimitus-, jakelu- ja yhteistyösopimukset',
      'Riskien kohdentaminen ja sopimusvastuu'
    ],
    ctaLabel: 'Arvioidaan sopimuksia',
    href: '#contact',
    image: '/media/IMG_5760.JPG',
    imageAlt: 'Sopimuksen tarkistus ja kynä lähellä'
  },
  {
    id: 'corporate',
    title: 'Yhtiöoikeus',
    description: 'Tuemme hallituksia ja johtoa omistajapolitiikassa, hallinnossa ja yhtiörakenteissa.',
    bullets: [
      'Hallitustyö, osakassopimukset ja sisäinen ohjaus',
      'Pääomarakenteet ja yhtiöjärjestelyt'
    ],
    ctaLabel: 'Vahvistetaan hallintoa',
    href: '#contact',
    image: '/media/IMG_5760.JPG',
    imageAlt: 'Johtoryhmä keskustelemassa modernissa tilassa'
  },
  {
    id: 'legal-operations',
    title: 'Oikeudelliset toiminnot',
    description: 'Rakennamme prosessit, automaation ja toimintamallit, jotka tekevät juridisesta työtä ennustettavaksi ja kustannustehokkaaksi.',
    bullets: [
      'Prosessikartoitukset, työkalut ja toimintamallit',
      'Noudattamisen valvonta ja kustannustehokas raportointi'
    ],
    ctaLabel: 'Tehostetaan oikeudellista toimintaa',
    href: '#contact',
    image: '/media/IMG_5760.JPG',
    imageAlt: 'Työpöytä, jossa näkyy prosessikaavio ja suunnitelma'
  }
];
---

<Layout title={title} description={description} lang="fi">
  <section class="page-hero">
    <div class="hero-copy">
      <p class="eyebrow">Palvelut</p>
      <h1>Oikeudellista neuvontaa kasvaville yrityksille ja strategisille sijoittajille.</h1>
      <p>Modernia juridista tukea transaktioihin, sopimuksiin, yhtiöoikeuteen ja oikeudelliseen operointiin — liiketuloksia tukeva lähestymistapa.</p>
      <a class="hero-button" href="#services-grid">Tutustu palveluihin</a>
    </div>

    <figure class="hero-media" aria-hidden="true">
      <img
        src={hero.src}
        srcset={hero.srcset}
        sizes="(max-width: 900px) 100vw, 50vw"
        alt="Liiketoimintakokous modernissa toimistossa"
        loading="eager"
        decoding="async"
      />
    </figure>
  </section>

  <section id="services-grid" class="services-grid">
    {services.map((service) => (
      <ServiceCard
        id={service.id}
        title={service.title}
        description={service.description}
        bullets={service.bullets}
        ctaLabel={service.ctaLabel}
        href={service.href}
        image={service.image}
        imageAlt={service.imageAlt}
      />
    ))}
  </section>

  <section class="service-highlight">
    <div class="highlight-copy">
      <h2>Miksi asiakkaat valitsevat CCL Advisoryn</h2>
      <p>Työskentelemme rajatun asiakasmäärän kanssa, jotta voimme tarjota pikaista, johtotason neuvontaa, selkeät dokumentit ja käytännöllisen juridisen puitteen kasvullesi.</p>
      <ul>
        <li>Prioriteetti vanhaan, senioritason neuvontaan ja luotettavaan toimeenpanoon.</li>
        <li>Kaupallinen selkeys perustajille, sijoittajille ja hallituksille.</li>
      </ul>
      <a class="highlight-cta" href="#contact">Varaa strategiapuheenvuoro</a>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    background: #f7f4ef;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 0.9fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 4vw, 4rem);
  }

  .hero-copy {
    max-width: 720px;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.8rem;
    font-weight: 700;
    color: #9c8b73;
    margin-bottom: 1.25rem;
  }

  .page-hero h1 {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    line-height: 1.05;
    margin: 0;
    color: #111111;
    max-width: 11ch;
  }

  .page-hero p {
    max-width: 40rem;
    margin: 1.5rem 0 0;
    color: #444444;
    line-height: 1.85;
    font-size: 1.05rem;
  }

  .hero-button {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.75rem;
    background: #b18f6a;
    color: white;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 220ms ease, background 220ms ease;
  }

  .hero-button:hover {
    transform: translateY(-1px);
    background: #8f6f49;
  }

  .hero-media img {
    width: 100%;
    height: auto;
    box-shadow: 0 28px 90px rgba(22, 22, 22, 0.11);
    display: block;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
    max-width: 1300px;
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 4rem);
  }

  .service-highlight {
    background: #ffffff;
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 5.5rem);
    max-width: 1180px;
    box-shadow: 0 20px 60px rgba(22,22,22,0.06);
  }

  .highlight-copy h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 3vw, 3rem);
    color: #111111;
  }

  .highlight-copy p {
    max-width: 40rem;
    margin-bottom: 1.5rem;
    color: #444444;
    line-height: 1.8;
  }

  .highlight-copy ul {
    margin: 0;
    padding-left: 1.2rem;
    list-style: disc;
    color: #333333;
    line-height: 1.8;
  }

  .highlight-cta {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    border: 1px solid #b18f6a;
    background: transparent;
    color: #111111;
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .page-hero {
      grid-template-columns: 1fr;
    }
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .page-hero {
      padding: 2.5rem 1.25rem;
    }
    .service-highlight {
      padding: 2rem 1.25rem;
    }
  }
</style>
