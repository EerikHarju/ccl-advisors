---
import Layout from '../../layouts/Layout.astro';
import rawHeroImage from '../../../public/media/IMG_5760.JPG';
import rawWhyImage from '../../../public/media/IMG_5760.JPG';
import rawRefsImage from '../../../public/media/IMG_5760.JPG';
import { getImage } from 'astro:assets';

const prefix = '/fi';

const optimizedHero = await getImage({ src: rawHeroImage });
const optimizedWhy = await getImage({ src: rawWhyImage });
const optimizedRefs = await getImage({ src: rawRefsImage });

const modules = import.meta.glob('/src/content/references/*.json', { eager: true });

// Unwrap the JSON modules
const references = Object.values(modules).map(m => m.default);

const safeReferences = references.length > 0
  ? references
  : [{ text: 'References coming soon...', date: 'TBD' }];

const title = "CCL Advisory";
const description = "Boutique-lakitoimisto, joka tarjoaa räätälöityjä juridisia palveluja.";
---

<Layout title={title} description={description} lang="fi">
  <section class="hero-section" style={`background-image: url(${optimizedHero.src});`}>
    <div class="hero-content">
      <h1>CCL Advisory</h1>
      <p>Räätälöityä juridista ja liiketoiminnallista neuvontaa yrityksille ja sijoittajille.</p>
      <a href="#contact" class="hero-cta">Ota yhteyttä</a>
    </div>
  </section>

  <section class="about-section">
    <div class="about-content about-opaque">
      <h2>Yritys</h2>
      <p>
        CCL Advisory on boutique-lakitoimisto, joka tarjoaa räätälöityjä ja korkeatasoisia juridisia ratkaisuja yrityksille ja yksityishenkilöille. 
        Tarjoamme asiantuntemusta transaktioihin, kaupallisiin sopimuksiin, yhtiöoikeuteen ja oikeudelliseen operointiin.
      </p>
      <p>
        Sitoutumisemme laatuun ja asiakaslähtöisyyteen tekee meistä luotettavan kumppanin monimutkaisissa liiketoimintaympäristöissä.
      </p>
      <a href="/fi/about" class="about-cta">Lue lisää</a>
    </div>
  </section>

  <section class="why-section" style={`background-image: url(${optimizedWhy.src});`}>
    <div class="why-content">
      <h2>Miksi valita CCL Advisory?</h2>
      <div class="why-grid">
        <div class="why-card">
          <h3>Räätälöidyt ratkaisut</h3>
          <p>
            Jokainen asiakas ja toimeksianto on ainutlaatuinen. Otamme vastaan vähemmän toimeksiantoja ja keskitymme täyden huomion asiakkaan tarpeisiin.
          </p>
        </div>
        <div class="why-card">
          <h3>Oikeudellinen huippuosaaminen</h3>
          <p>
            Tarkka ja liiketaloudellinen lähestymistapa mahdollistaa vahvan juridisen neuvonnan. Seuraamme markkinamuutoksia ja sääntelyä jatkuvasti.
          </p>
        </div>
        <div class="why-card">
          <h3>Tuloshakuinen palvelu</h3>
          <p>
            Menestyksesi on tavoitteemme. Rakennamme pitkäjänteisiä kumppanuuksia, selkeytämme prosesseja ja tuemme liiketoiminnan kasvua.
          </p>
        </div>
        
        <div class="why-card">
          <h3>Selkeä viestintä</h3>
          <p>
            Vältymme oikeudiskielestä ja selitämme vaihtoehdot, riskit ja seuraavat askeleet ymmärrettävästi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="services-list-section">
    <div class="services-list-inner">
      <h2 class="services-list-title">What we do</h2>

      <div class="services-list-items">
        <a class="service-row" href={`${prefix}/services#transactions`}>
          <span>Kaupankäynti</span>
          <span class="service-row-icon">+</span>
        </a>

        <a class="service-row" href={`${prefix}/services#commercial-contracts`}>
          <span>Kaupalliset sopimukset</span>
          <span class="service-row-icon">+</span>
        </a>

        <a class="service-row" href={`${prefix}/services#corporate`}>
          <span>Yhtiöoikeus</span>
          <span class="service-row-icon">+</span>
        </a>

        <a class="service-row" href={`${prefix}/services#legal-operations`}>
          <span>Oikeudelliset toiminnot</span>
          <span class="service-row-icon">+</span>
        </a>
      </div>
    </div>
  </section>


  <section id="references" class="refs-section" style={`background-image: url(${optimizedRefs.src});`}>
    <script
      type="application/json"
      id="refs-data"
      set:html={JSON.stringify(safeReferences)}
    ></script>
    <div class="refs-overlay"></div>
    <div class="refs-inner">
      <h2 class="refs-title">Latest references</h2>

      <div class="refs-slide">
        <p class="refs-text" id="refs-text">
          {safeReferences[0].text}
        </p>
        <p class="refs-date" id="refs-date">
          {safeReferences[0].date}
        </p>
      </div>

      <button class="refs-arrow refs-arrow-left" type="button" aria-label="Previous reference" id="refs-prev">
        ←
      </button>
      <button class="refs-arrow refs-arrow-right" type="button" aria-label="Next reference" id="refs-next">
        →
      </button>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const raw = document.getElementById("refs-data").textContent;
        console.log('RAW JSON FROM SCRIPT TAG:', raw, 'TYPE:', typeof raw);

        let items;
        try {
          items = JSON.parse(raw);
          console.log('PARSED ITEMS:', items, 'TYPE:', typeof items, 'LENGTH:', items.length);
        } catch (e) {
          console.error('JSON PARSE FAILED:', e);
          return;
        }

        let index = 0;

        const textEl = document.getElementById('refs-text');
        const dateEl = document.getElementById('refs-date');
        const prevBtn = document.getElementById('refs-prev');
        const nextBtn = document.getElementById('refs-next');

        console.log('ELEMENTS:', { textEl, dateEl, prevBtn, nextBtn });

        function render() {
          const item = items[index];

          // Fade out
          textEl.classList.add('fade-out');
          dateEl.classList.add('fade-out');

          setTimeout(() => {
            // Update content while faded out
            textEl.textContent = item.text;
            dateEl.textContent = item.date;

            // Fade back in
            textEl.classList.remove('fade-out');
            dateEl.classList.remove('fade-out');
          }, 200); // matches half the CSS transition
        }

        render();

        prevBtn.addEventListener('click', () => {
          console.log('CLICK PREV BEFORE:', index);
          index = (index - 1 + items.length) % items.length;
          console.log('CLICK PREV AFTER:', index);
          render();
        });

        nextBtn.addEventListener('click', () => {
          console.log('CLICK NEXT BEFORE:', index);
          index = (index + 1) % items.length;
          console.log('CLICK NEXT AFTER:', index);
          render();
        });
      });
    </script>


  </section>

</Layout>

<style>
  .hero-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    height: 100vh;
    min-height: 600px;
    background-position: center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-content {
    text-align: center;
    color: white;
    max-width: 750px;
    padding: 1.5rem;
  }

  .hero-section h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 600;
    line-height: 1.15;
    margin: 1rem 0 7.55rem 0;
    color: white !important;
  }

  .hero-section p {
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 300;
    line-height: 1.5;
    color: white;
    max-width: 750px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta,
  .about-cta {
    width: 240px;
    height: 62px;
    line-height: 58px;
    padding: 0;
    display: block;
    text-align: center;
    border-radius: 40px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 300ms ease;
    text-decoration: none;
  }

  .hero-cta {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.6);
    color: white;
    margin: 1rem auto 2rem auto;
  }

  .hero-cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.9);
    transform: translateY(-2px);
  }

  .about-section {
    padding: 6rem 0;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-content {
    max-width: min(900px, 100%);
    width: 100%;
    margin: 0 auto;
    background: #ffffff;
    box-shadow: 0 28px 100px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .about-opaque {
    background: transparent;
    padding: clamp(2rem, 4vw, 3rem);
  }


  .about-section h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 1.5rem 0;
    text-align: left;
    color: rgb(var(--black));
  }

  .about-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
    color: rgb(var(--gray-dark));
    text-align: left;
    max-width: 650px;
  }

  .about-cta {
    background: transparent;
    border: 2px solid rgba(0, 0, 0, 0.6);
    color: rgba(0, 0, 0, 0.75);
    margin: 2rem auto 0 auto;
  }

  .about-cta:hover {
    background: rgba(0, 0, 0, 0.1);
    border-color: rgba(0, 0, 0, 0.75);
    transform: translateY(-2px);
  }

  .why-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    padding: 4rem 0;
    background-position: center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .why-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .why-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.52);
    z-index: 0;
  }

  .why-section h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 3rem 0;
    text-align: left;
    color: rgb(var(--black));
    position: relative;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    position: relative;
  }

  .why-card {
    padding: 2rem;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .why-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
    color: rgb(var(--black));
  }

  .why-card p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0;
    color: rgb(var(--gray-dark));
    text-align: left;
  }

  .services-list-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    padding: 6rem 0;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .services-list-inner {
    width: 100%;
    max-width: 1200px;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr);
    gap: 4rem;
  }

  .services-list-title {
    font-size: clamp(2.6rem, 4vw, 3.2rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #111111;
    margin: 0;
    align-self: flex-start;
  }

  .services-list-items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-self: center;
  }

  .service-row {
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: none;
    border-bottom: 2px solid #111111;
    color: #111111;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: clamp(1.3rem, 2.3vw, 1.6rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
  }

  .service-row-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .service-row:hover {
    opacity: 0.8;
  }

  /* References carousel */
  .refs-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    height: 100vh;
    min-height: 600px;
    background-position: center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0;
  }

  .refs-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 0;
  }

  .refs-inner {
    position: relative;
    z-index: 1;
    max-width: 800px;
    width: 100%;
    padding: 0 3rem;
    text-align: center;
    color: #ffffff;
    margin: 0 auto;
  }

  .refs-title {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 500;
    margin-bottom: 3rem;
    color: #ffffff;
  }

  .refs-slide {
    max-width: 720px;
    margin: 0 auto;
  }

  .refs-text {
    font-size: 1.2rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .refs-date {
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .refs-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    cursor: pointer;
  }

  .refs-arrow-left {
    left: 0;
  }

  .refs-arrow-right {
    right: 0;
  }

  .refs-arrow:hover {
    background: #ffffff;
  }

  .refs-text,
  .refs-date {
    opacity: 1;
    transition: opacity 0.35s ease;
  }

  .refs-text.fade-out,
  .refs-date.fade-out {
    opacity: 0;
  }


  @media (max-width: 768px) {
    .hero-section {
      background-attachment: scroll;
      height: 100vh;
      background-position: center 40%;
    }

    .hero-content {
      padding: 1.25rem;
    }

    .about-section {
      padding: 4rem 1.5rem;
    }

    .why-section {
      padding: 3rem 1rem;
      background-attachment: scroll;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .services-list-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .services-list-title {
      text-align: left;
    }

    .refs-section {
      background-attachment: scroll;
      padding: 4rem 1.5rem;
    }

    .refs-inner {
      padding: 0 1.5rem;
      max-width: 100%;
    }

    .refs-arrow-left {
      left: 1rem;
    }

    .refs-arrow-right {
      right: 1rem;
    }
  }
</style>
