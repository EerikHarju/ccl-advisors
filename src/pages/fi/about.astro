---
import Layout from '../../layouts/Layout.astro';
import rawHeroImage from '../../../public/media/IMG_5760.JPG';
import rawWhyImage from '../../../public/media/IMG_5760.JPG';

import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

const optimizedHero = await getImage({ src: rawHeroImage });
const optimizedWhy = await getImage({ src: rawWhyImage });

const title = 'CCL Advisory | Tietoa meistä';
const description =
  'Yksilöllistä ja korkealaatuista lakineuvontaa kompleksisiin transaktioihin, sopimuksiin ja yritysoikeuteen.';


---

<Layout title={title} description={description} lang="fi">
  <section class="hero-section" style={`background-image: url(${optimizedHero.src});`}>
    <div class="hero-content">
      <h1>CCL Advisory</h1>
      <p>Räätälöityjä lakipalveluja ja liiketoiminnallista neuvontaa.</p>
      <a href="#contact" class="hero-cta">Ota yhteyttä</a>
    </div>
  </section>

  <section class="why-section">
    <div class="why-content">
      <h2>Tietoa CCL Advisorystä</h2>
      <div class="why-grid">
        <div class="why-card">
          <p>
            CCL Advisory on erikoistunut lakitoimisto ja liiketoiminnan neuvontatalo, joka tarjoaa räätälöityjä ratkaisuja transaktioihin, yhtiöoikeuteen ja oikeudelliseen operointiin.
            Osaamisemme keskittyy laatuun, asiakaslähtöisyyteen ja liiketaloudelliseen näkemykseen.
          </p>
          <p>
            Yrityksen perusti Mikko Harju, ja sen toimintaperiaate perustuu tarkkaan, asiakaskohtaiseen tuen tarjoamiseen.
            Mikolla on yli 20 vuoden kokemus kansainvälisistä järjestelyistä ja juridisesta neuvonnasta Euroopassa ja Aasiassa.
          </p>
        </div>
        <div class="why-card">
          <p>
            Mikon kokemus kattaa M&A:n, yritysjärjestelyt, yhteisyritykset, yhtiörakenteet ja kaupalliset sopimukset.
            Hän yhdistää tarkan oikeudellisen osaamisen ja käytännön liiketoimintaosaamisen varmistaakseen, että neuvonta on sekä strategista että toteuttamiskelpoista.
          </p>
          <p>
            Ennen CCL Advisoryn perustamista Mikko työskenteli muun muassa KPMG:n M&A Legal -tiimissä Helsingissä.
            Ota yhteyttä, jos haluat keskustella yrityksesi transaktioista, sopimuksista tai yhtiöjärjestelyistä.
          </p>
        </div>
      </div>
    </div>
  </section>

  </Layout>

<style>
  .hero-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    height: 100vh;
    min-height: 600px;
    background-position: center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-content {
    text-align: center;
    color: white;
    max-width: 750px;
    padding: 1.5rem;
  }

  .hero-section h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 600;
    line-height: 1.15;
    margin: 1rem 0 7.55rem 0;
    color: white !important;
  }

  .hero-section p {
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 300;
    line-height: 1.5;
    color: white;
    max-width: 750px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta,
  .about-cta {
    width: 240px;
    height: 62px;
    line-height: 58px;
    padding: 0;
    display: block;
    text-align: center;
    border-radius: 40px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 300ms ease;
    text-decoration: none;
  }

  .hero-cta {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.6);
    color: white;
    margin: 1rem auto 2rem auto;
  }

  .hero-cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.9);
    transform: translateY(-2px);
  }

  .why-section {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    padding: 4rem 0;
    background-position: center center;
    background-size: cover;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .why-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .why-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.52);
    z-index: 0;
  }

  .why-section h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 3rem 0;
    text-align: left;
    color: rgb(var(--black));
    position: relative;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    position: relative;
  }

  .why-card {
    padding: 2rem;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .why-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
    color: rgb(var(--black));
  }

  .why-card p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0;
    color: rgb(var(--gray-dark));
    text-align: left;
  }

  @media (max-width: 768px) {
    .hero-section {
      background-attachment: scroll;
      height: 100vh;
      background-position: center 40%;
    }

    .hero-content {
      padding: 1.25rem;
    }

    .why-section {
      padding: 3rem 1rem;
      background-attachment: scroll;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
